# Copy to deploy/.env and fill in. deploy/.env is git-ignored - never commit it.
# Generate each secret with:  openssl rand -base64 32

# Public address of the site (a DuckDNS subdomain or your own domain), without https://
DOMAIN=volunteerportal.duckdns.org
# Let's Encrypt sends certificate expiry warnings here
ACME_EMAIL=you@example.org

# Database passwords (the app's user, and MySQL root for backups)
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Signs the rotating QR check-in codes; keep it stable (changing it only invalidates codes on screen)
CHECKIN_SECRET=

# The first admin account, created on the first start only (never again once a user with this
# name exists, even if its roles are changed later). Log in and change the password.
ADMIN_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=
ADMIN_EMAIL=you@example.org
SEED_ADMIN=true

# Optional: an SMTP mail server for "Forgot your password?" emails (e.g. your email provider's SMTP
# settings, or a service such as Brevo or Mailgun). Leave MAIL_HOST empty to turn it off; admins can still
# set a new password for a user under Admin > Users. MAIL_FROM must be an address the server may send as.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Time zone for event times and "now" (check-in windows, upcoming events)
TZ=Asia/Riyadh

# Java memory: share of the VM's RAM for the heap
JAVA_OPTS=-XX:MaxRAMPercentage=75
